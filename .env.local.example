NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 토스플레이스 Open API (개발자센터 → 내 애플리케이션 → 인증 정보)
TOSS_PLACE_ACCESS_KEY=
TOSS_PLACE_SECRET_KEY=
# /api/pos/toss/sync 호출 인증 (pg_cron 헤더 x-sync-secret 와 동일 값)
POS_SYNC_SECRET=

# NAVER API HUB (네이버 클라우드) — Search Trend + Search. 홈 트렌드 픽
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=
# Anthropic API — 홈 트렌드 픽 메뉴 후보 생성 (주 1회)
ANTHROPIC_API_KEY=

# 광고 현황 대시보드 게시 (/api/ads/publish 헤더 x-ads-secret 와 동일 값)
ADS_PUBLISH_SECRET=

# 광고 현황 "오늘" 탭 — 광고 API 직접 조회 (조회 전용). 값은 광고 모니터링 폴더의 네이버광고/.env, secrets/ 에 있는 것과 동일
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
# 구글 애즈 서비스 계정 키 JSON 을 한 줄로 통째로 (secrets/google-ads-sa.json 내용)
GOOGLE_ADS_SA_JSON=
# 메타 시스템 사용자 토큰 (secrets/meta-token.txt 내용)
META_ADS_TOKEN=
