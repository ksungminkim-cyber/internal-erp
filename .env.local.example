NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 토스플레이스 Open API (개발자센터 → 내 애플리케이션 → 인증 정보)
TOSS_PLACE_ACCESS_KEY=
TOSS_PLACE_SECRET_KEY=
# /api/pos/toss/sync 호출 인증 (pg_cron 헤더 x-sync-secret 와 동일 값)
POS_SYNC_SECRET=

# 네이버 개발자센터 앱 (데이터랩 검색어 트렌드 + 검색) — 홈 트렌드 픽
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Anthropic API — 홈 트렌드 픽 메뉴 후보 생성 (주 1회)
ANTHROPIC_API_KEY=
